# Local PostgreSQL container. These values are development-only placeholders.
POSTGRES_DB=lab_attendance
POSTGRES_USER=lab_attendance
POSTGRES_PASSWORD=lab_attendance_dev
POSTGRES_PORT=5435

# Server-only application configuration.
AUTH_SECRET=replace-with-at-least-32-random-characters
ATTENDANCE_CRON_SECRET=replace-with-a-separate-32-character-random-secret
AUTH_TRUST_HOST=true
DATABASE_URL=postgresql://lab_attendance:lab_attendance_dev@localhost:5435/lab_attendance?schema=public
LAB_INSTANCE_PUBLIC_URL=http://localhost:3000
LAB_INSTANCE_SLUG=main-lab
LAB_INSTANCE_NAME=Laboratorio principal
LAB_INSTANCE_TIMEZONE=America/Santiago
QR_SIGNING_SECRET=replace-with-a-separate-32-character-random-secret

# Automatic first-start registration. Disable this and remove the initial
# password after the lab and administrator have been created.
INSTANCE_BOOTSTRAP_ENABLED=true
LAB_BOOTSTRAP_ADMIN_NAME=Administrador general
LAB_BOOTSTRAP_ADMIN_EMAIL=admin@lab.local
LAB_BOOTSTRAP_ADMIN_INITIAL_PASSWORD=replace-before-production
